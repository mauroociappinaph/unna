# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fudo?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase (opcional - si usas Supabase Auth en lugar de custom)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Frontend
FRONTEND_URL="http://localhost:3000"

# App
PORT=3001
NODE_ENV=development

# Email (Resend - 3k emails/mes gratis)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="UNNA <noreply@tudominio.com>"
EMAIL_REPLY_TO="soporte@tudominio.com"

# Facturación ARCA (ex AFIP). Sin estas variables se usa el simulador (nunca en producción).
# El certificado y la clave van fuera del repo; ver docs y odd S12.
ARCA_ENV="homologacion"            # homologacion | produccion
ARCA_CERT_PATH="/ruta/fuera/del/repo/unna-homo.crt"
ARCA_KEY_PATH="/ruta/fuera/del/repo/unna-homo.key"
# ARCA_TIMEOUT_MS="15000"

# Mercado Pago QR (S15). Sin MP_CLIENT_ID y MP_CLIENT_SECRET se usa un simulador (nunca en producción).
# Ver docs/integraciones/mercadopago-qr.md.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Callback OAuth registrado en la aplicación, p. ej. https://api.example.com/api/v1/mercadopago/oauth/callback
MP_REDIRECT_URI=""
# Secreto de firma del webhook "Order (Mercado Pago)". Vacío = todo webhook se rechaza con 401.
MP_WEBHOOK_SECRET=""
# 32 bytes en base64 (openssl rand -base64 32). Obligatoria en producción; vacía fuera de producción usa
# una clave fija de desarrollo que NO protege nada.
MP_TOKEN_ENCRYPTION_KEY=""

# Pantalla pública de pedidos: límite por IP por minuto (por defecto 120)
# PUBLIC_BOARD_RATE_LIMIT="120"
# Cantidad de proxies delante de la API (en hosting suele ser 1), para limitar por IP real
# TRUST_PROXY="1"

# Ambiente de prueba (S16). Solo con el valor exacto "staging" y NODE_ENV=production se permiten los
# simuladores de ARCA y Mercado Pago. Un ambiente staging nunca debe tener datos reales de clientes ni cobros reales.
UNNA_ENV=""
# La web muestra "Ambiente de prueba" cuando vale "staging" (se fija al compilar la web).
NEXT_PUBLIC_UNNA_ENV=""
